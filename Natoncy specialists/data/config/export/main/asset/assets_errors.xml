      <Standard>
        <GUID>1404000896</GUID>
        <Name>Salim al-Masri, Juice Counterfeiter</Name>
        <IconFilename>data/modgraphics/icons/Salim_a_m.png</IconFilename>
        <InfoDescription>1404000939</InfoDescription>
      </Standard>
      <Text>
        <LocaText>
          <English>
            <Text>Salim al-Masri, Juice Counterfeiter</Text>
          </English>
        </LocaText>
      </Text>
      <Item>
        <MaxStackSize>3</MaxStackSize>
        <Rarity>Epic</Rarity>
