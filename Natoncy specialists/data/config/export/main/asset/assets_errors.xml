            <Attribute>Faith</Attribute>
            <Amount>25</Amount>
          </Item>
        </ExpeditionAttributes>
        <ItemDifficulties>Hard</ItemDifficulties>
      </ExpeditionAttribute>
    </Values>
  </Asset>
</ModOp>















