          </Item>
        </AdditionalOutput>
        <ReplaceInputs>
          <Item>
            <OldInput></OldInput>            <!-- pomegranate-->
            <NewInput>133097</NewInput>
          </Item>
        </ReplaceInputs>
      </FactoryUpgrade>
      <ItemEffect>
        <EffectTargets>
          <Item>
            <GUID></GUID>            <!-- pomegranate juice workshop-->
