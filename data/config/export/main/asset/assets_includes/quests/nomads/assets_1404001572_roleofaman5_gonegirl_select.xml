                </Standard>
                <Text>
                    <LocaText>
                        <English>
                            <Text>Hamza hopes that by comforting his cousin's family, you may learn where she has gone.</Text>
                            <Status>Exported</Status>
                        </English>
                    </LocaText>
                    <LineID>43742</LineID>
