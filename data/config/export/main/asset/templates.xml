        <Template>
          <Name>HarborOffice_Unique</Name>
          <Properties>
            <Standard />
            <Building>
              <BuildingType>Factory</BuildingType>
              <BuildingCategoryName>100001</BuildingCategoryName>
              <TerrainType>Water_Including_Coast</TerrainType>
            </Building>
            <Blocking />
            <Cost>
              <InfluenceCostType>HarborOffice</InfluenceCostType>
            </Cost>
            <Object>
              <IgnoreForMinimapGeneration>1</IgnoreForMinimapGeneration>
            </Object>
            <Mesh />
            <Selection>
              <GUIType>Guildhouse</GUIType>
              <OnSelection>
                <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                <Values>
                  <ActionList />
                </Values>
              </OnSelection>
              <AllowedDragType>ItemSocket;CargoItemStack;StorageItemStack;SharedTransferItem</AllowedDragType>
            </Selection>
            <Text />
            <Constructable>
              <DestructionCategory>Production</DestructionCategory>
            </Constructable>
            <Locked />
            <SoundEmitter>
              <DestroySounds>
                <Item>
                  <Sound>9818756</Sound>
